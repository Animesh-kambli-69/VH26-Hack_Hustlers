NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shopverse:shopverse@postgres:5432/shopverse?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CORS_ORIGIN=http://localhost:3000
CACHE_CAPACITY=10
CACHE_DEFAULT_TTL=60
CACHE_ADMISSION_THRESHOLD=0.20
CAAC_W_FREQUENCY=0.25
CAAC_W_RECENCY=0.15
CAAC_W_COST=0.30
CAAC_W_LATENCY=0.15
CAAC_W_TREND=0.15
CAAC_RECENCY_LAMBDA=0.001
CAAC_SIZE_PENALTY_FACTOR=0.000001
RECOMMENDATION_DELAY_MS=2000
RECOMMENDATION_COMPUTE_COST=5
RECOMMENDATION_DB_COST=3
RECOMMENDATION_EXTERNAL_COST=1
ANALYTICS_DELAY_MS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
