# API base URL used by the dashboard.
#
# Recommended (default when unset): same-origin "/api" — Vite proxies it to
# http://localhost:3000/api in `npm run dev` / `npm run preview`, which avoids
# CORS entirely.
#
# Direct mode: point straight at the backend. Only works if the backend CORS
# config allows this origin (see CORS_ORIGIN in the backend .env).
VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=http://localhost:3000/api