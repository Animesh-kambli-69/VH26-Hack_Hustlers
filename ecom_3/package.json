{
  "name": "shopverse-cost-aware-adaptive-cache",
  "version": "1.0.0",
  "description": "API-only e-commerce backend demonstrating a cost-aware adaptive cache.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "test": "jest --runInBand",
    "workload:steady": "node scripts/run-workload.js steady",
    "workload:spike": "node scripts/run-workload.js spike",
    "workload:expensive": "node scripts/run-workload.js expensive-rare",
    "workload:gradual": "node scripts/run-workload.js gradual-shift",
    "workload:cold": "node scripts/run-workload.js cold-start",
    "benchmark": "node scripts/run-benchmark.js"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^5.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
