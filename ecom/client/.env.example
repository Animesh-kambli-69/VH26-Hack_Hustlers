# ------------------------------------------------------------------
# ShopVerse client environment — template.
# Copy to .env and adjust. Only VITE_-prefixed vars reach the browser.
# ------------------------------------------------------------------

# Base URL the browser uses for API calls (src/api/client.js).
# Leave empty in development → same-origin /api (proxied by Vite).
# For a deployed frontend pointing at a remote API, set e.g.
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=

# Dev-only: where the Vite dev server proxies /api requests
# (read by vite.config.js).
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
