# ------------------------------------------------------------------
# ShopVerse server environment — template.
# Copy to .env and adjust. Real environment variables always win.
# ------------------------------------------------------------------

# --- API server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# ------------------------------------------------------------------
# Adaptive cache (server/src/services/cache) — optional overrides.
# Defaults are shown; the config can also be changed live at runtime
# via POST /api/cache/config (the dashboard sliders do this).
# ------------------------------------------------------------------

# adaptive | gdsf | no-cache  (no-cache = Phase 1 behaviour)
# CACHE_MODE=adaptive

# Modeled memory budget for the cache (entries carry sizeMB metadata).
# CACHE_CAPACITY_MB=15

# Utility-score weights: wL (latency), wM (money cost), lambda (decay/s).
# CACHE_W_LAT=1
# CACHE_W_MONEY=1
# CACHE_LAMBDA=0.01

# ------------------------------------------------------------------
# Phase 2 (scaling) — placeholders, not wired yet.
# Uncomment when the DB layers are implemented.
# ------------------------------------------------------------------

# Redis cache (will be read by server/src/cache/ when added)
# REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL (will replace the demo JSON file store in db/fileDb.js)
# DATABASE_URL=postgres://shopverse:shopverse@127.0.0.1:5432/shopverse
